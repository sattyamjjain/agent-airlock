    {"id": "subject-backtick", "tool": "atxp_tool", "arguments": {"subject": "Invoice `id`"}, "argument": "subject", "token": "`", "verdict": "deny_shell_metachar"},
    {"id": "subject-substitution", "tool": "atxp_tool", "arguments": {"subject": "Invoice $(id)"}, "argument": "subject", "token": "$(", "verdict": "deny_shell_metachar"},
    {"id": "query-substitution", "tool": "atxp_tool", "arguments": {"query": "from:billing $(id)"}, "argument": "query", "token": "$(", "verdict": "deny_shell_metachar"},
    {"id": "query-backtick", "tool": "atxp_tool", "arguments": {"query": "from:billing `id`"}, "argument": "query", "token": "`", "verdict": "deny_shell_metachar"}

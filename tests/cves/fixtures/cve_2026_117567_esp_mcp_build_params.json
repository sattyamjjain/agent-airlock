    {"id": "variable-reference", "tool": "build_project", "arguments": {"project_path": "$IDF_PATH/examples/blink", "project_name": "blink", "target": "esp32", "port": "/dev/ttyUSB0"}, "why": "$NAME expansion is left out of the default set"}

    {"id": "query-substitution", "tool": "sf_data_query", "arguments": {"target-org": "dev@example.test", "query": "SELECT Id FROM Account $(id)"}, "argument": "query", "token": "$(", "verdict": "deny_shell_metachar"},
    {"id": "target-org-substitution", "tool": "sf_data_query", "arguments": {"target-org": "dev@example.test$(id)", "query": "SELECT Id FROM Account"}, "argument": "target-org", "token": "$(", "verdict": "deny_shell_metachar"},

{
  "$schema": "https://raw.githubusercontent.com/anthropics/claude-plugins-official/main/schemas/plugin.schema.json",
  "name": "agent-airlock",
  "version": "0.8.62",
  "description": "A deny-by-default type-checker and contract layer for AI agent tool calls: strict Pydantic argument validation, ghost-argument stripping, and self-healing retries for MCP servers and agent frameworks. In-process, Pydantic-only.",
  "summary": "A deny-by-default type-checker and contract layer for AI agent tool calls — the in-process check that runs beneath your MCP gateway.",
  "homepage": "https://github.com/sattyamjjain/agent-airlock",
  "repository": {
    "type": "git",
    "url": "https://github.com/sattyamjjain/agent-airlock.git"
  },
  "license": "MIT",
  "keywords": [
    "mcp",
    "security",
    "ai-agents",
    "validation",
    "tool-validation",
    "contract-layer",
    "sandbox",
    "pii",
    "oauth",
    "pkce",
    "cve"
  ],
  "categories": [
    "security",
    "mcp-middleware",
    "agent-runtime"
  ],
  "maintainer": {
    "name": "Sattyam Jain",
    "email": "sattyamjjain@gmail.com",
    "url": "https://github.com/sattyamjjain"
  },
  "install": {
    "pypi": "agent-airlock",
    "extras": {
      "bench": "Adaptive-attacker benchmark harness (AgentDojo)",
      "sandbox": "E2B Firecracker micro-VM sandbox execution",
      "modal": "Modal-backed sandbox execution",
      "mcp": "FastMCP integration + @secure_tool decorator",
      "claude-agent": "Claude Agent SDK integration",
      "model-armor": "Google Cloud Model Armor prompt/response classifier",
      "console": "Textual TUI for `airlock console`",
      "redis": "Redis-backed distributed rate limiter",
      "crypto": "Ed25519 signed agent identity",
      "attested": "MCP attested tool-server admission (offline Ed25519 / RSA-PSS)",
      "pydantic-ai": "PydanticAI canonical-leg adapter",
      "crewai": "CrewAI canonical-leg adapter",
      "all": "sandbox, mcp, claude-agent, model-armor, console, redis, crypto, pydantic-ai, crewai"
    }
  },
  "minimum_claude_version": "1.0.0",
  "tags": [
    "mcp-2025-11-25",
    "oauth-2.1",
    "cve-regression-suite",
    "owasp-mcp-top-10"
  ],
  "documentation": {
    "readme": "https://github.com/sattyamjjain/agent-airlock#readme",
    "quickstart": "https://github.com/sattyamjjain/agent-airlock/blob/main/docs/getting-started/quickstart.md",
    "cve_catalog": "https://github.com/sattyamjjain/agent-airlock/blob/main/docs/cves/index.md",
    "compliance": "https://github.com/sattyamjjain/agent-airlock/blob/main/docs/COMPATIBILITY.md"
  }
}

      "allowed_before": true,
      "verdict": "deny_subquery_in_fragment",
      "field": "where_clause"
    },
    {
      "tool": "a table name carrying a clause",
      "args": {"table_name": "users WHERE 1=1"},
      "allowed_before": true,
      "verdict": "deny_not_an_identifier",
      "field": "table_name"
    },
    {

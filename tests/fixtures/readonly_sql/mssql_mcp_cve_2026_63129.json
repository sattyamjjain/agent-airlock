  "benign": [
    {"tool": "update_data", "args": {"tableName": "dbo.orders", "whereClause": "status = 'open'"}},
    {"tool": "list_databases", "args": {"stateFilter": "ONLINE"}},
    {"tool": "insert_data", "args": {"tableName": "orders", "data": {"name": "x", "qty": 2}}},

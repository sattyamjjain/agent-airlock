    "upstream_issue": "https://github.com/codefriar/sf-mcp/issues/17",
    "vulnerable_code": "https://github.com/codefriar/sf-mcp/blob/beb103dced68962e0c069b62cb377286751d0103/src/utils.ts#L79-L90",
    "triage_issue": "https://github.com/sattyamjjain/agent-airlock/issues/387"
  },
  "payloads": [
